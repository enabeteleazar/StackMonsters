# En production : Vercel → Settings → Environment Variables. En local : .env.local (jamais commité).

# Valeurs possibles : MAINTENANCE ou PRODUCTION (défaut : PRODUCTION).
STATUS_APP=PRODUCTION

# Postgres (injectée par l'intégration Neon).
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Secret qui protège les codes de connexion. Génère-le : openssl rand -hex 32
SESSION_SECRET=

# Envoi des codes par e-mail (Resend). Expéditeur à adapter à ton domaine vérifié.
RESEND_API_KEY=
MAIL_FROM="StackMonsters <onboarding@resend.dev>"

# Ton e-mail : à ta première connexion, tu récupères l'ancienne collection unique.
OWNER_EMAIL=

# Suivi du trafic (dashboard stackmonsters-dashboard) : adresse de collecte, intégrée au build.
# Vide = https://stackmonster-dashboard.vercel.app/api/collect. Penser à l'autoriser dans connect-src (vercel.json).
VITE_TRACK_URL=

# Lien du compte Instagram affiché en pied de page (accueil et Réglages) ; vide = pas de lien.
VITE_INSTAGRAM_URL=
