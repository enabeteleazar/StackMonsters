# En production : Vercel → Settings → Environment Variables. En local : .env.local (jamais commité).

# Postgres (injectée par l'intégration Neon).
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Secret qui protège les codes de connexion. Génère-le : openssl rand -hex 32
SESSION_SECRET=

# Envoi des codes par e-mail (Resend). Expéditeur à adapter à ton domaine vérifié.
RESEND_API_KEY=
MAIL_FROM=StackMonster <onboarding@resend.dev>

# Ton e-mail : à ta première connexion, tu récupères l'ancienne collection unique.
OWNER_EMAIL=
