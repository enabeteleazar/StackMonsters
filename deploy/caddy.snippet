# À insérer dans le bloc de site homebox.tail7f8e60.ts.net du Caddyfile.
# L'ordre d'écriture n'a pas d'importance : Caddy trie les handle par
# spécificité, donc /monsters/api* passe avant /monsters*.

handle_path /monsters/api* {
	reverse_proxy 127.0.0.1:8055
}

handle_path /monsters* {
	root * /srv/canStack/dist
	file_server
	try_files {path} /index.html
}
