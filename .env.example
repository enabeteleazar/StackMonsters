# Copie ce fichier en .env.local (jamais commité) pour développer en local.
# En production, ces variables se règlent dans Vercel (Settings → Environment Variables).

# Chaîne de connexion Postgres. Avec l'intégration Neon de Vercel elle est
# injectée automatiquement ; en local : `vercel env pull .env.local`.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Jeton d'accès à l'API. Génère-en un long : openssl rand -hex 24
API_TOKEN=
